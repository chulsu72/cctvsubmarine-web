---
import SectionHeader from './common/SectionHeader.astro';
import { features } from '../data/features';
---

<section class="section" id="features">
  <div class="container">
    <SectionHeader eyebrow="KEY FEATURES" title="The essential CCTV workflow, connected." lead="From a live camera wall to a precise recorded moment, each capability is designed as part of one coherent video workflow." />
    <div class="feature-grid">
      {features.map((feature) => (
        <article>
          <span class="feature-code">{feature.code}</span>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
          <small>{feature.badge}</small>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .feature-grid {
    display: grid;
    margin-top: 3rem;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  article {
    min-height: 13rem;
    padding: 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: linear-gradient(145deg, rgba(20,36,58,.82), rgba(10,21,36,.62));
  }

  .feature-code {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-brand-hover);
    background: var(--color-brand-soft);
    font-size: 0.68rem;
    font-weight: 800;
  }

  h3 {
    margin: 1rem 0 0;
    font-size: 1.08rem;
  }

  article p {
    margin-top: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  article small {
    display: inline-block;
    margin-top: 1.1rem;
    color: var(--color-success);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 62rem) {
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 36rem) {
    .feature-grid { grid-template-columns: 1fr; }
  }
</style>
