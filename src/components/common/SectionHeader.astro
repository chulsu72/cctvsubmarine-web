---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="section-header">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <p class="lead">{lead}</p>
</header>

<style>
  .section-header {
    max-width: 52rem;
  }

  h2 {
    margin-top: 0.65rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .lead {
    margin-top: 0.9rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
  }
</style>
