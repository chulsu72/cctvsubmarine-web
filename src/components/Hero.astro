---
import { Image } from 'astro:assets';
import liveView from '../assets/images/screenshots/main-screen-fullscreen-2560.png';

const releasesUrl = 'https://github.com/chulsu72/cctvsubmarine-releases/releases/latest';
const githubUrl = 'https://github.com/chulsu72/cctvsubmarine-web';
const capabilities = ['LIVE', 'RECORD', 'SEARCH', 'PLAYBACK', 'AI READY'];
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">CCTV VIDEO MANAGEMENT PLATFORM</p>
      <h1>See. Record. Search.<br /><span>Playback. Smarter.</span></h1>
      <p class="lead">CctvSubmarine is a modular video management platform for real-time CCTV monitoring, reliable recording, fast search and timeline-based playback.</p>
      <div class="actions">
        <a class="button button--primary" href="#products">Explore Platform</a>
        <a class="button" href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      </div>
      <ul class="capabilities" aria-label="Platform capabilities">
        {capabilities.map((item) => <li>{item}</li>)}
      </ul>
      <a class="release-link" href={releasesUrl} target="_blank" rel="noreferrer">Latest test release available →</a>
    </div>
    <div class="viewer-shell">
      <div class="viewer-bar">
        <span>CctvSubmarine Viewer</span>
        <span class="status"><i></i> SYSTEM ONLINE</span>
      </div>
      <Image src={liveView} alt="CctvSubmarine 64-channel live monitoring interface" format="webp" quality={82} widths={[640, 960, 1280]} sizes="(max-width: 960px) 100vw, 50vw" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 5.5rem 0 6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(rgba(59,130,246,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,.045) 1px, transparent 1px);
    background-size: 3rem 3rem;
    content: '';
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .hero-grid {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 1fr) minmax(32rem, 1.05fr);
    gap: 4.5rem;
  }

  h1 {
    max-width: 42rem;
    margin-top: 1rem;
    font-size: clamp(3rem, 5.3vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  h1 span {
    color: var(--color-brand-hover);
  }

  .lead {
    max-width: 38rem;
    margin-top: 1.75rem;
    color: var(--color-text-secondary);
    font-size: 1.06rem;
  }

  .actions {
    display: flex;
    margin-top: 2rem;
    gap: 0.75rem;
  }

  .capabilities {
    display: flex;
    flex-wrap: wrap;
    margin: 2rem 0 0;
    padding: 0;
    gap: 0.5rem;
    list-style: none;
  }

  .capabilities li {
    padding: 0.38rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: rgba(16, 29, 45, 0.72);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .release-link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .release-link:hover {
    color: var(--color-brand-hover);
  }

  .viewer-shell {
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-panel), 0 0 70px rgba(59, 130, 246, 0.12);
  }

  .viewer-bar {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-muted);
  }

  .status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 12px var(--color-success);
  }

  .viewer-shell :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9.6;
    object-fit: cover;
    object-position: left top;
  }

  @media (max-width: 68rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .viewer-shell {
      width: min(100%, 54rem);
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding: 4rem 0;
    }

    .hero-grid {
      gap: 2.75rem;
    }

    .actions {
      align-items: stretch;
      flex-direction: column;
    }

    .viewer-bar {
      font-size: 0.62rem;
    }
  }
</style>
