---
const links = [
  { label: 'Products', href: '#products' },
  { label: 'Features', href: '#features' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Roadmap', href: '#roadmap' },
];

const githubUrl = 'https://github.com/chulsu72/cctvsubmarine-web';
const releasesUrl = 'https://github.com/chulsu72/cctvsubmarine-releases/releases/latest';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="CctvSubmarine home">
      <span>CctvSubmarine</span>
      <small>CCTV VMS LAB</small>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        <li><a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a></li>
      </ul>
    </nav>
    <a class="button button--primary download" href={releasesUrl} target="_blank" rel="noreferrer">Download</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    top: 0;
    border-bottom: 1px solid rgba(49, 80, 119, 0.55);
    background: rgba(7, 16, 28, 0.88);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .brand small {
    color: var(--color-text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    gap: 1.75rem;
    list-style: none;
  }

  nav a {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 600;
  }

  nav a:hover {
    color: var(--color-text-primary);
  }

  .download {
    min-height: 3rem;
  }

  @media (max-width: 60rem) {
    nav {
      display: none;
    }

    .download {
      margin-left: auto;
    }
  }

  @media (max-width: 34rem) {
    .header-inner {
      min-height: 4.75rem;
      gap: 1rem;
    }

    .brand small {
      display: none;
    }

    .download {
      min-height: 2.75rem;
      padding-inline: 1rem;
      font-size: 0.85rem;
    }
  }
</style>
